# ── AI: AWS Bedrock (production — cantarapet account, us-east-1) ─────────────
AI_PROVIDER=bedrock
AWS_REGION=us-east-1

# Option A (easiest): Bedrock console → Discover → API keys → Generate long-term key
AWS_BEARER_TOKEN_BEDROCK=

# Option B (production server): IAM user access key with bedrock:InvokeModel
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional overrides if AWS renames model IDs (defaults map Sonnet 4 → 4.6, etc.)
# BEDROCK_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_OPUS_MODEL=us.anthropic.claude-opus-4-6-v1
# BEDROCK_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local dev fallback only — direct Anthropic API (set AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Nylas (for Google OAuth + Drive integration) ──────────────────────────────
# Create an application at https://dashboard.nylas.com
NYLAS_CLIENT_ID=your_nylas_client_id
NYLAS_CLIENT_SECRET=your_nylas_client_secret
NYLAS_API_KEY=your_nylas_api_key
NYLAS_API_URI=https://api.us.nylas.com

# ── Google Drive (via Nylas or direct) ────────────────────────────────────────
# When using Nylas connector, Drive access is handled via Nylas grants.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET only needed if using Google directly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Composio (integrations) ───────────────────────────────────────────────────
COMPOSIO_API_KEY=

# DocuSign: no Composio-managed app — create Auth Config in Composio dashboard
# (preferred) OR provide Integration Key + Secret Key to auto-create one.
# COMPOSIO_DOCUSIGN_AUTH_CONFIG_ID=ac_xxxxxxxx
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_ENVIRONMENT=demo
# DOCUSIGN_AUTHORIZATION_URL=https://account-d.docusign.com

# Contract-send automation (Make → Cantara). Dry-run ON by default (no live DocuSign).
# CONTRACTS_MONDAY_BOARD_ID=18398612826
# DOCUSIGN_TEMPLATE_MA=c5c3e4e8-d37a-41ea-bdb6-195805f5e325
# DOCUSIGN_TEMPLATE_CONSULTING=
# AUTOMATIONS_CONTRACT_SEND_DRY_RUN=true
# AUTOMATIONS_CONTRACT_SEND_UPDATE_MONDAY=false
# CONTRACTS_MONDAY_WEBHOOK_SECRET=

# Embedded signing (Gmail “Review & Sign NDA” → DocuSign 302). Dry-run ON by default.
# AUTOMATIONS_EMBEDDED_SIGNING_DRY_RUN=true
# AUTOMATIONS_EMBEDDED_SIGNING_UPDATE_MONDAY=false
# DOCUSIGN_EMBEDDED_RETURN_URL=https://app.docusign.com
# TEASER_COL_STATUS=color_mm2p27bz
# TEASER_STATUS_ERROR=Error - See Update

# ── App ───────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here

# ── Database (production — replace localStorage with a real DB) ───────────────
# DATABASE_URL=postgresql://user:pass@host:5432/cantara

# ── S3 / AWS Uploads ───────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=your_bucket_name
# Optional for S3-compatible providers:
# S3_ENDPOINT=
