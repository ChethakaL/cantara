generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model LeaseAnalysis {
  id        String        @id @default(cuid())
  clientId  String
  fileName  String
  report    String
  parsed    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ContractAnalysis {
  id        String        @id @default(cuid())
  clientId  String
  fileName  String
  report    String
  parsed    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model CompetitorAnalysis {
  id        String        @id @default(cuid())
  clientId  String
  fileName  String
  report    String
  parsed    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model EmployeeObligationsReport {
  id            String        @id @default(cuid())
  clientId      String
  markdown      String
  documentNames String[]      @default([])
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model TtmAnalysis {
  id                String              @id @default(cuid())
  clientId          String
  version           Int
  status            TtmRunStatus        @default(RUNNING)
  hitlStatus        TtmHitlStatus       @default(PENDING_REVIEW)
  inputFingerprint  String
  model             String
  temperature       Float
  maxTokens         Int
  inputSnapshot     Json
  normalizedData    Json?
  structuredModel   Json?
  ttmSummary        Json?
  annualModel       Json?
  workingCapital    Json?
  dataQualityReport Json?
  summary           Json?
  errorMessage      String?
  approvedAt        DateTime?
  approvedByName    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reportMarkdown    String?
  dispatchTasks     AgentDispatchTask[]
  client            ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  flags             TtmFlag[]
  derivedReports    Ws2DerivedReport[]
  recastAnalyses    Ws2RecastAnalysis[]

  @@unique([clientId, version])
  @@index([clientId, createdAt])
  @@index([clientId, inputFingerprint])
}

model TtmFlag {
  id                     String                   @id @default(cuid())
  analysisId             String
  section                TtmFlagSection
  severity               TtmFlagSeverity
  title                  String
  description            String?
  payload                Json
  resolutionStatus       TtmFlagResolutionStatus  @default(OPEN)
  resolutionAction       TtmFlagResolutionAction?
  resolutionNotes        String?
  escalatedRequirementId String?
  resolvedAt             DateTime?
  resolvedByName         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  analysis               TtmAnalysis              @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, section])
  @@index([analysisId, resolutionStatus])
}

model AgentDispatchTask {
  id         String              @id @default(cuid())
  analysisId String
  clientId   String
  agentId    String
  status     AgentDispatchStatus
  payload    Json?
  releasedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  analysis   TtmAnalysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  client     ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([analysisId, agentId])
  @@index([clientId, status])
}

model Ws2RecastAnalysis {
  id               String             @id @default(cuid())
  clientId         String
  ttmAnalysisId    String
  version          Int
  status           TtmRunStatus       @default(RUNNING)
  hitlStatus       TtmHitlStatus      @default(PENDING_REVIEW)
  model            String
  temperature      Float
  maxTokens        Int
  assumptions      Json
  reportMarkdown   String?
  parsedReport     Json?
  workbookKey      String?
  workbookUrl      String?
  normalizedEbitda Float?
  valuationLow     Float?
  valuationMid     Float?
  valuationHigh    Float?
  errorMessage     String?
  approvedAt       DateTime?
  approvedByName   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  derivedReports   Ws2DerivedReport[]
  client           ClientProfile      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ttmAnalysis      TtmAnalysis        @relation(fields: [ttmAnalysisId], references: [id], onDelete: Cascade)
  flags            Ws2RecastFlag[]

  @@unique([ttmAnalysisId, version])
  @@index([clientId, createdAt])
}

model Ws2RecastFlag {
  id               String                   @id @default(cuid())
  recastAnalysisId String
  severity         TtmFlagSeverity
  title            String
  description      String?
  payload          Json
  resolutionStatus TtmFlagResolutionStatus  @default(OPEN)
  resolutionAction TtmFlagResolutionAction?
  resolutionNotes  String?
  overrideAmount   Float?
  resolvedAt       DateTime?
  resolvedByName   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  recastAnalysis   Ws2RecastAnalysis        @relation(fields: [recastAnalysisId], references: [id], onDelete: Cascade)

  @@index([recastAnalysisId, resolutionStatus])
}

model Ws2DerivedReport {
  id               String                 @id @default(cuid())
  clientId         String
  ttmAnalysisId    String
  recastAnalysisId String?
  agentId          Ws2DerivedAgentId
  status           Ws2DerivedReportStatus @default(RUNNING)
  reportMarkdown   String?
  parsedReport     Json?
  errorMessage     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  client           ClientProfile          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recastAnalysis   Ws2RecastAnalysis?     @relation(fields: [recastAnalysisId], references: [id], onDelete: Cascade)
  ttmAnalysis      TtmAnalysis            @relation(fields: [ttmAnalysisId], references: [id], onDelete: Cascade)

  @@unique([ttmAnalysisId, agentId])
  @@index([clientId, createdAt])
}

model ClientDocument {
  id                  String           @id @default(cuid())
  requestId           String?
  clientId            String
  uploadedById        String
  fileName            String
  mimeType            String
  size                Int
  localPath           String
  googleDriveFileId   String?
  createdAt           DateTime         @default(now())
  aiBusinessNameMatch Boolean?
  aiDetectedType      String?
  aiReviewFlags       String[]         @default([])
  aiReviewStatus      String?
  aiReviewSummary     String?
  aiReviewedAt        DateTime?
  documentId          String?
  storageBucket       String?
  storageProvider     String?          @default("s3")
  ClientProfile       ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  DocumentRequest     DocumentRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  User                User             @relation(fields: [uploadedById], references: [id])

  @@index([clientId, createdAt])
}

model TeamMember {
  id        String        @id @default(cuid())
  clientId  String
  name      String
  email     String
  role      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model AdvisorProfile {
  id        String        @id @default(cuid())
  clientId  String
  name      String
  imageUrl  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientDocumentStatus {
  id            String        @id @default(cuid())
  clientId      String
  documentId    String
  hasDoc        Boolean?
  assignedTo    String?
  uploadedAt    DateTime?
  fileName      String?
  notApplicable Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  fileUrl       String?
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, documentId])
  @@index([clientId, updatedAt])
}

model ClientProfile {
  id                         String                      @id @default(cuid())
  userId                     String                      @unique
  businessName               String
  businessDescription        String?
  email                      String?
  phone                      String?
  workstream                 Workstream?
  businessType               BusinessType                @default(SINGLE)
  stage                      ClientStage                 @default(ONBOARDING)
  driveFolderId              String?
  notes                      String?
  valuationDocUploaded       Boolean                     @default(false)
  provisionedAt              DateTime?
  lastLogin                  DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  sectionSubmissions         Json?
  approvedNormalizedEbitda   Float?
  approvedNormalizedEbitdaAt DateTime?
  businessAddress            String?
  businessCategory           String?
  websiteUrl                 String?
  AdditionalRequirements     AdditionalRequirement[]
  AdvisorProfiles            AdvisorProfile[]
  AgentDispatchTasks         AgentDispatchTask[]
  Branches                   Branch[]
  ChatMessages               ChatMessage[]
  ClientDocument             ClientDocument[]
  ClientDocumentStatuses     ClientDocumentStatus[]
  User                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  CompetitorAnalyses         CompetitorAnalysis[]
  ContractAnalysis           ContractAnalysis[]
  DocumentRequest            DocumentRequest[]
  EmployeeObligationsReports EmployeeObligationsReport[]
  LeaseAnalysis              LeaseAnalysis[]
  Questions                  Question[]
  TeamMembers                TeamMember[]
  TtmAnalyses                TtmAnalysis[]
  Ws2DerivedReports          Ws2DerivedReport[]
  Ws2RecastAnalyses          Ws2RecastAnalysis[]
}

model Branch {
  id       String        @id @default(cuid())
  name     String
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id           String        @id @default(cuid())
  clientId     String
  senderRole   Role
  senderName   String
  message      String
  timestamp    DateTime      @default(now())
  readByAdmin  Boolean       @default(false)
  readByClient Boolean       @default(false)
  client       ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, timestamp])
}

model AdditionalRequirement {
  id                     String            @id @default(cuid())
  clientId               String
  title                  String
  description            String?
  priority               Priority          @default(MEDIUM)
  status                 RequirementStatus @default(OPEN)
  createdAt              DateTime          @default(now())
  clientResponse         String?
  question               String?
  requestUpload          Boolean           @default(false)
  respondedAt            DateTime?
  responseFileName       String?
  responseFileUrl        String?
  sourceDocumentId       String?
  sourceDocumentName     String?
  sourceUploadedFileName String?
  client                 ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model DocumentRequest {
  id             String           @id @default(cuid())
  clientId       String
  title          String
  description    String?
  createdById    String
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  ClientDocument ClientDocument[]
  ClientProfile  ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [createdById], references: [id])

  @@index([clientId, createdAt])
}

model Question {
  id            String        @id @default(cuid())
  clientId      String
  askedById     String
  question      String
  answer        String?
  answeredAt    DateTime?
  createdAt     DateTime      @default(now())
  User          User          @relation(fields: [askedById], references: [id])
  ClientProfile ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model User {
  id                        String            @id @default(cuid())
  name                      String
  email                     String            @unique
  passwordHash              String
  role                      Role              @default(CLIENT)
  googleAccessToken         String?
  googleRefreshToken        String?
  googleTokenExpiry         DateTime?
  googleDriveRootFolderId   String?
  googleDriveRootFolderName String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  ClientDocument            ClientDocument[]
  ClientProfile             ClientProfile?
  DocumentRequest           DocumentRequest[]
  Questions                 Question[]
  Sessions                  Session[]
}

enum Role {
  ADMIN
  CLIENT
}

enum ClientStage {
  ONBOARDING
  COLLECTION
  REVIEW
  FINAL
  CLOSED
}

enum Workstream {
  WS1
  WS2
  BOTH
  MA
}

enum BusinessType {
  SINGLE
  MULTI
  PARENT
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum RequirementStatus {
  OPEN
  RESOLVED
}

enum TtmRunStatus {
  RUNNING
  HITL_PENDING
  APPROVED
  FAILED
}

enum TtmHitlStatus {
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
}

enum TtmFlagSection {
  A
  B
  C
  D
  E
}

enum TtmFlagSeverity {
  HIGH
  MEDIUM
  LOW
  INFO
}

enum TtmFlagResolutionStatus {
  OPEN
  ACTIONED
}

enum TtmFlagResolutionAction {
  RESOLVE
  OVERRIDE
  ESCALATE_CLIENT
}

enum AgentDispatchStatus {
  BLOCKED_HITL
  READY
  RELEASED
}

enum Ws2DerivedAgentId {
  ws2_3_rev_vertical_v1
  ws2_4_benchmark_v1
  ws2_5_labor_v1
  ws2_10_report_generator_v1
}

enum Ws2DerivedReportStatus {
  RUNNING
  COMPLETE
  FAILED
}
